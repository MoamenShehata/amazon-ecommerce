FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 5000
EXPOSE 5001

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["identity-management/Amazon.Identity.Presentation/Amazon.Identity.Presentation.csproj", "Amazon.Identity.Presentation/"]
COPY identity-management/ .
COPY lib/ /lib
COPY shared-kernel/ /shared-kernel
RUN dotnet restore "./Amazon.Identity.Presentation/Amazon.Identity.Presentation.csproj"

WORKDIR "/src/Amazon.Identity.Presentation"
RUN dotnet build "./Amazon.Identity.Presentation.csproj" -o /app/build

FROM build AS publish
RUN dotnet publish "./Amazon.Identity.Presentation.csproj" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .


ENTRYPOINT ["dotnet", "Amazon.Identity.Presentation.dll"]