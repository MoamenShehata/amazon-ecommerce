FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["gateway/Amazon.Apis.Gateway/Amazon.Apis.Gateway.csproj", "Amazon.Apis.Gateway/"]
COPY gateway/ .
RUN dotnet restore "./Amazon.Apis.Gateway/Amazon.Apis.Gateway.csproj"

WORKDIR "/src/Amazon.Apis.Gateway"
RUN dotnet build "./Amazon.Apis.Gateway.csproj" -o /app/build

FROM build AS publish
RUN dotnet publish "./Amazon.Apis.Gateway.csproj" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .


ENTRYPOINT ["dotnet", "Amazon.Apis.Gateway.dll"]