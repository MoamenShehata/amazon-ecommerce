FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["product-catalog/Amazon.ProductCatalog.Api/Amazon.ProductCatalog.Api.csproj", "Amazon.ProductCatalog.Api/"]
COPY ["product-catalog/Amazon.ProductCatalog.Application/Amazon.ProductCatalog.Application.csproj", "Amazon.ProductCatalog.Application/"]
COPY ["product-catalog/Amazon.ProductCatalog.Domain/Amazon.ProductCatalog.Domain.csproj", "Amazon.ProductCatalog.Domain/"]
COPY ["product-catalog/Amazon.ProductCatalog.Infrastructure/Amazon.ProductCatalog.Infrastructure.csproj", "Amazon.ProductCatalog.Infrastructure/"]
COPY lib/ /lib
COPY product-catalog/ .
COPY shared-kernel/ /shared-kernel
RUN dotnet restore "./Amazon.ProductCatalog.Api/Amazon.ProductCatalog.Api.csproj"

WORKDIR "/src/Amazon.ProductCatalog.Api"
RUN dotnet build "./Amazon.ProductCatalog.Api.csproj" -o /app/build

FROM build AS publish
RUN dotnet publish "./Amazon.ProductCatalog.Api.csproj" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .


ENTRYPOINT ["dotnet", "Amazon.ProductCatalog.Api.dll"]