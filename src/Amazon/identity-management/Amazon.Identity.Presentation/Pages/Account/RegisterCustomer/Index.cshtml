@page
@model VidGuard.Platform.Authentication.Pages.Account.RegisterCustomer.Index

<div class="login-page">
	<div class="lead">
		<h1>Sign up a new customer</h1>
	</div>

	<partial name="_ValidationSummary" />
	

	<div class="row">

		<div class="col-sm-6">
			<form asp-page="/Account/Create/Index">
				<input type="hidden" asp-for="Input.ReturnUrl" />

				<div class="row">
					
					<div class="col-md-6">
						<div class="form-group">
							<label asp-for="Input.PhoneNumber"></label> <partial name="_required" />
							<input class="form-control" placeholder="Mobile1" asp-for="Input.PhoneNumber" autofocus required>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-md-6">
						<div class="form-group">
							<label asp-for="Input.Email"></label> <partial name="_required" />
							<input type="email" class="form-control" placeholder="Email" asp-for="Input.Email" required>
						</div>
					</div>

					<div class="col-md-6">
						<div class="form-group">
							<label asp-for="Input.Password"></label> <partial name="_required" />
							<input type="password" class="form-control" placeholder="Password" asp-for="Input.Password" autocomplete="off" required>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-12">
						<button class="btn btn-primary" name="Input.Button" value="create">Create</button>
						<button class="btn btn-secondary" name="Input.Button" value="cancel">Cancel</button>
					</div>
				</div>
			</form>
		</div>

	</div>
</div>
