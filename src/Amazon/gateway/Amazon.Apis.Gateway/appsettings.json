{
  "YarbConfigurations": {
    "Routes": {
      "customers-service": {
        "ClusterId": "customers-cluster",
        "Match": {
          "Path": "/customers/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      }
    },
    "Clusters": {
      "customers-cluster": {
        "Destinations": {
          "local-auth-service": {
            "Address": "https://localhost:7128"
          }
        }
      }
    }
  }
}