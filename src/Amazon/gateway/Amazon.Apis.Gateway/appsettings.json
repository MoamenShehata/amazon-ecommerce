{
  "YarbConfigurations": {
    "Routes": {
      "customers-service": {
        "ClusterId": "customers-cluster",
        "Match": {
          "Path": "/customers/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "orders-service": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "lookups-service": {
        "ClusterId": "lookups-cluster",
        "Match": {
          "Path": "lookups/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/lookups" },
          { "PathPrefix": "/api" }
        ]
      },
      "media-service": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/files/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "customers-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7128"
          }
        }
      },

      "orders-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7270"
          }
        }
      },

      "lookups-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7158"
          }
        }
      },
      
      "media-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "http://localhost:5104/"
          }
        }
      }
    }
  }
}
