{
  "YarbConfigurations": {
    "Routes": {
      "customers-service": {
        "ClusterId": "customers-cluster",
        "Match": {
          "Path": "/customers/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "cart-service": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/carts/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "payments-service": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/paymentMethods/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "catalog-cats-service": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/categories/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "catalog-prods-service": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "orders-service": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [ { "PathPrefix": "/api" } ]
      },
      "lookups-service": {
        "ClusterId": "lookups-cluster",
        "Match": {
          "Path": "lookups/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/lookups" },
          { "PathPrefix": "/api" }
        ]
      },
      "media-service": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/files/{**catch-all}"
        }
      },
      "notifications-service": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/notificationHub/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "customers-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7128"
          }
        }
      },

      "cart-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7101"
          }
        }
      },

      "orders-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7270"
          }
        }
      },

      "catalog-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7182"
          }
        }
      },

      "lookups-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7158"
          }
        }
      },

      "media-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "local-instance": {
            "Address": "https://localhost:7043"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://localhost:5341/"
        }
      },
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Level:u3}] {Message:lj}" }
      }
    ]
  }
}
