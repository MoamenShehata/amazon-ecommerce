FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["notifications/Amazon.Notifications.Api/Amazon.Notifications.Api.csproj", "Amazon.Notifications.Api/"]
COPY notifications/ .
COPY lib/ /lib
COPY shared-kernel/ /shared-kernel
RUN dotnet restore "./Amazon.Notifications.Api/Amazon.Notifications.Api.csproj"

WORKDIR "/src/Amazon.Notifications.Api"
RUN dotnet build "./Amazon.Notifications.Api.csproj" -o /app/build

FROM build AS publish
RUN dotnet publish "./Amazon.Notifications.Api.csproj" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .


ENTRYPOINT ["dotnet", "Amazon.Notifications.Api.dll"]