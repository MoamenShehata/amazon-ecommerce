FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["inventory/Amazon.Inventory.Grpc/Amazon.Inventory.Grpc.csproj", "Amazon.Inventory.Grpc/"]
COPY ["inventory/Amazon.Inventory.Application/Amazon.Inventory.Application.csproj", "Amazon.Inventory.Application/"]
COPY ["inventory/Amazon.Inventory.Domain/Amazon.Inventory.Domain.csproj", "Amazon.Inventory.Domain/"]
COPY ["inventory/Amazon.Inventory.Infrastructure/Amazon.Inventory.Infrastructure.csproj", "Amazon.Inventory.Infrastructure/"]
COPY lib/ /lib
COPY inventory/ .
COPY shared-kernel/ /shared-kernel
RUN dotnet restore "./Amazon.Inventory.Grpc/Amazon.Inventory.Grpc.csproj"

WORKDIR "/src/Amazon.Inventory.Grpc"
RUN dotnet build "./Amazon.Inventory.Grpc.csproj" -o /app/build

FROM build AS publish
RUN dotnet publish "./Amazon.Inventory.Grpc.csproj" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .


ENTRYPOINT ["dotnet", "Amazon.Inventory.Grpc.dll"]