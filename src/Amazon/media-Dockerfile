FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["media/Media.Api/Media.Api.csproj", "Media.Api/"]
COPY ["media/Media.Application/Media.Application.csproj", "Media.Application/"]
COPY ["media/Media.Domain/Media.Domain.csproj", "Media.Domain/"]
COPY ["media/Media.Infrastructure/Media.Infrastructure.csproj", "Media.Infrastructure/"]
COPY media/ .
COPY lib/ /lib
COPY shared-kernel/ /shared-kernel
RUN dotnet restore "./Media.Api/Media.Api.csproj"

WORKDIR "/src/Media.Api"
RUN dotnet build "./Media.Api.csproj" -o /app/build

FROM build AS publish
RUN dotnet publish "./Media.Api.csproj" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .


ENTRYPOINT ["dotnet", "Media.Api.dll"]